# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Required. Your bot token from @BotFather
TELEGRAM_CHANNEL_ID=         # Optional. Channel to broadcast rates to e.g. @your_channel or -100xxxxxxxxxx
CRON_SCHEDULE=*/10 * * * *   # Optional. How often to post to channel (default: every 10 min)

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_CHAT_ID=               # Optional. Your Telegram chat ID — restricts /stats to you only

# ── PAJ rate source ───────────────────────────────────────────────────────────
PAJ_ENV=production           # Optional. "production" (default) or "staging"

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=                    # Optional. Path to persist data files (alerts, users, meta).
                             # On Fly.io, set this to your mounted volume path e.g. /data

# ── Supabase (required for buy-USDC / onramp flow) ────────────────────────────
SUPABASE_URL=                # Required. e.g. https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # Required. Service role key (never expose publicly)

# ── PajCash (required for buy-USDC / NGN onramp) ─────────────────────────────
PAJCASH_ENV=production       # "production" | "staging" | "local"
PAJCASH_API_KEY=             # Required. Your PajCash API key
PAJCASH_SESSION_RECIPIENT=   # Required. Email or phone registered with PajCash
PAJCASH_SESSION_TOKEN=       # Required. Bearer token from OTP verification
PAJCASH_SESSION_EXPIRES_AT=  # ISO date string when the session token expires
PAJCASH_WEBHOOK_PATH_SECRET= # Required. Random secret appended to webhook URL (min 12 chars)
PAJCASH_WEBHOOK_BASE_URL=    # Required. Public URL this bot is reachable at e.g. https://yourbot.fly.dev
PAJCASH_BUSINESS_USDC_FEE=   # Optional. Extra USDC fee you charge (e.g. 0.05)
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # Mainnet USDC mint
