# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Required. Your bot token from @BotFather
TELEGRAM_CHANNEL_ID=         # Optional. Channel to broadcast rates to e.g. @your_channel or -100xxxxxxxxxx
CRON_SCHEDULE=*/10 * * * *   # Optional. How often to post to channel (default: every 10 min)

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_CHAT_ID=               # Optional. Your Telegram chat ID — restricts /stats to you only

# ── PAJ rate source ───────────────────────────────────────────────────────────
PAJ_ENV=production           # Optional. "production" (default) or "staging"

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=                    # Optional. Path to persist data files (alerts, users, meta).
                             # On Fly.io, set this to your mounted volume path e.g. /data
